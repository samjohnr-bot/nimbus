NIMBUS_ENV=demo
KALSHI_API_KEY=your-api-key-id
# Use ONE of these two options:
# Option 1: File path (local dev)
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi-demo.pem
# Option 2: Base64-encoded PEM (cloud deployment)
# KALSHI_PRIVATE_KEY=base64-encoded-pem-here
NIMBUS_DRY_RUN=true
NIMBUS_EDGE_THRESHOLD=0.08
NIMBUS_MAX_TRADE_SIZE=7500
NIMBUS_MAX_DAILY_LOSS=15000
NIMBUS_KELLY_FRACTION=0.15
NIMBUS_POLL_INTERVAL=10
LOG_LEVEL=info
